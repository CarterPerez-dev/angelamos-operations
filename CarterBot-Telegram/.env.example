# CarterOS Telegram Bot Configuration

# Required - from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required - your Telegram user ID (get from @userinfobot)
TELEGRAM_ALLOWED_USERS=your_user_id_here

# Optional - override paths
CLAUDE_WORKING_DIR=/home/yoshi/dev/operations/angelamos-operations/carter-telegram-bot
WHISPER_CLI_PATH=/home/yoshi/tools/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/home/yoshi/tools/whisper.cpp/models/ggml-medium.bin

# GPU Whisper service (Docker)
WHISPER_SERVICE_URL=http://localhost:5069
TRANSCRIPTION_DIR=/home/yoshi/Transcriptions

# Optional - thinking keywords
THINKING_KEYWORDS=think,reason,analyze
THINKING_DEEP_KEYWORDS=ultrathink,think hard,deep think
